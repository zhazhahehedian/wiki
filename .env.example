# =============================================================
# Capability Hub 环境变量模板
# 用法: 复制本文件为 .env, 替换标记 [REPLACE_ME] 的值
# .env 已在根 .gitignore 中, 不会入库
# =============================================================

# ----- PostgreSQL -----
# 使用已准备好的开发数据库；本仓库不提供 Compose 服务编排。
DATABASE_URL=postgres://itwiki:itwiki_dev_pass@localhost:5432/itwiki?sslmode=disable

# ----- MinIO -----
# 现有对象存储服务及应用访问凭证
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_pass
S3_BUCKET=it-wiki-docs
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ----- 历史迁移兼容 -----
# 重放 0004 migration 仍需 pgvector 与正确维度；平台运行时不调用 Embedding。
EMBEDDING_DIM=1024

# ----- Backend -----
PORT=8080
LOG_LEVEL=info

# ----- Feishu OAuth / session -----
# Feishu console redirect URL must match this value exactly.
FEISHU_APP_ID=[REPLACE_ME]
FEISHU_APP_SECRET=[REPLACE_ME]
FEISHU_REDIRECT_URL=http://localhost:8080/api/v1/auth/feishu/callback
# Optional: set to restrict login to one Feishu tenant.
FEISHU_TENANT_KEY=
# Generate a private random key before enabling Feishu; never use a public template value.
# `openssl rand -hex 16` prints 32 random ASCII characters accepted by AES.
OAUTH_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
SESSION_TTL=24h
FRONTEND_ORIGIN=http://localhost:3000

# ----- Frontend -----
# 浏览器可访问的后端地址；前端单独启动时同步到 frontend/.env.local。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Optional development network transport -----
# PostgreSQL does not automatically use HTTP_PROXY. Leave empty for direct access.
DATABASE_PROXY_URL=
# Exact trusted model origins, separated by commas. Only these may use private
# destinations, HTTP, or HTTP_PROXY/HTTPS_PROXY. Never add wildcard/user input.
PLAYGROUND_TRUSTED_ORIGINS=https://tokenhub.robosense.cn
# HTTP_PROXY / HTTPS_PROXY may be supplied by the local process for S3 and Feishu.
# Set NO_PROXY=localhost,127.0.0.1 for local services when using a proxy.

# Capability Hub: persistent first admin, only fills an uninitialized installation.
# Feishu open_id may be provisioned before first login; changing/unsetting does not revoke it.
BOOTSTRAP_ADMIN_FEISHU_OPEN_ID=
